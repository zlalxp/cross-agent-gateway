{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
	}

	@health path /healthz /
	handle @health {
		reverse_proxy 127.0.0.1:8787
	}

	@authed header Authorization "Bearer {$AGENT_TOKEN}"
	handle @authed {
		reverse_proxy 127.0.0.1:8787
	}

	respond "unauthorized" 401
}
